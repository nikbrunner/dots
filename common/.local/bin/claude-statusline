#!/usr/bin/env bash
# Claude Code statusLine: account, model, repo/branch, context, limits, cost.
#
# Pure bash + one jq call. The previous statusline spawned a node process every
# 5s per session; un-stapled node binaries cannot have their Gatekeeper verdict
# cached, so each spawn forced a full signature validation and saturated
# syspolicyd — pushing every unrelated exec on the machine from ~1ms to ~75ms.
# Keep this dependency-free: no node, no npm, no per-render subprocess beyond jq.
#
# Payload schema: https://code.claude.com/docs/en/statusline.md

input=$(cat)

eval "$(
	printf '%s' "$input" | jq -r '
    @sh "transcript=\(.transcript_path // "")",
    @sh "model=\(.model.display_name // .model.id // "")",
    @sh "dir=\(.workspace.current_dir // .cwd // "")",
    @sh "worktree=\(.workspace.git_worktree // "")",
    @sh "repo=\(.workspace.repo.name // "")",
    @sh "ctx=\(.context_window.used_percentage // "")",
    @sh "hourly=\(.rate_limits.five_hour.used_percentage // "")",
    @sh "weekly=\(.rate_limits.seven_day.used_percentage // "")",
    @sh "cost=\(.cost.total_cost_usd // "")"
  ' 2>/dev/null
)"

dim=$'\033[38;5;240m'
reset=$'\033[0m'
out=""
add() { [ -n "$1" ] && out="${out:+$out ${dim}·${reset} }$1"; }

# Colour a percentage by how close it is to its ceiling.
heat() {
	if [ "${1%.*}" -ge 85 ] 2>/dev/null; then
		printf '\033[1;31m'
	elif [ "${1%.*}" -ge 60 ] 2>/dev/null; then
		printf '\033[38;5;179m'
	else
		printf '%s' "$dim"
	fi
}

# Work sessions authenticate via ANTHROPIC_API_KEY, so oauthAccount is null
# there and the payload carries no auth field at all. Identify the instance from
# transcript_path — the statusline subprocess does not reliably inherit
# CLAUDE_CONFIG_DIR. An unlabelled line always means broken, never "work".
# shellcheck disable=SC2154 # assigned by the eval'd jq output above
case "$transcript" in
*/.claude-work/*)
	add $'\033[1;31m⚠ WORK\033[0m'
	;;
*)
	config="${CLAUDE_CONFIG_DIR:+$CLAUDE_CONFIG_DIR/.claude.json}"
	email=$(jq -r '.oauthAccount.emailAddress // empty' "${config:-$HOME/.claude.json}" 2>/dev/null)
	add "${email:+$'\033[38;5;110m'${email%%@*}$reset}"
	;;
esac

add "${model:+$'\033[38;5;108m'$model$reset}"

label="${worktree:-${repo:-${dir##*/}}}"
if [ -n "$dir" ]; then
	branch=$(git -C "$dir" --no-optional-locks symbolic-ref --short -q HEAD 2>/dev/null)
	path_color=$'\033[38;5;245m'
	branch_color=$'\033[38;5;180m'
	add "${path_color}${label}${reset}${branch:+${branch_color} ⎇ ${branch}${reset}}"
fi

[ -n "$ctx" ] && add "$(heat "$ctx")$(printf 'ctx %.0f%%' "$ctx")$reset"
[ -n "$hourly" ] && add "$(heat "$hourly")$(printf '5h %.0f%%' "$hourly")$reset"
[ -n "$weekly" ] && add "$(heat "$weekly")$(printf '7d %.0f%%' "$weekly")$reset"
[ -n "$cost" ] && add "$(printf '%s$%.2f%s' "$dim" "$cost" "$reset")"

printf '%b\n' "$out"
