#!/usr/bin/env bash
# Claude Code statusLine: one row — repo, git, model, context, 5h limit.
# The dash-pane mod (common/.claude/mods/dash-pane) shows the full picture.
#
# Pure bash + one jq call + one git call. The previous statusline spawned a node
# process every 5s per session; un-stapled node binaries cannot have their
# Gatekeeper verdict cached, so each spawn forced a full signature validation
# and saturated syspolicyd — pushing every unrelated exec on the machine from
# ~1ms to ~75ms. Keep this dependency-free: no node, no npm, no per-render
# subprocess beyond jq and a single git status.
#
# Payload schema: https://code.claude.com/docs/en/statusline.md

input=$(cat)

# Declared so the eval below only ever overwrites a known set; an absent payload
# field then reads as empty rather than leaking a variable from the environment.
transcript='' model='' dir='' repo='' ctx='' hourly='' effort=''

eval "$(
	printf '%s' "$input" | jq -r '
    @sh "transcript=\(.transcript_path // "")",
    @sh "model=\(.model.display_name // .model.id // "")",
    @sh "dir=\(.workspace.current_dir // .cwd // "")",
    @sh "repo=\(.workspace.repo.name // "")",
    @sh "ctx=\(.context_window.used_percentage // "")",
    @sh "hourly=\(.rate_limits.five_hour.used_percentage // "")",
    @sh "effort=\(.effort.level // "")"
  ' 2>/dev/null
)"

dim=$'\033[38;5;240m'
reset=$'\033[0m'
icon_color=$'\033[38;5;179m'
bold=$'\033[1m'
green_b=$'\033[1;38;5;108m'
red=$'\033[1;31m'
blue=$'\033[38;5;110m'
gold=$'\033[38;5;180m'

# Nerd Font glyphs, matching the pi statusline.
i_dir=$''
i_branch=$''
i_ctx=$''

# Colour a percentage by how close it is to its ceiling.
heat() {
	if [ "${1%.*}" -ge 85 ] 2>/dev/null; then
		printf '\033[1;31m'
	elif [ "${1%.*}" -ge 60 ] 2>/dev/null; then
		printf '\033[38;5;179m'
	else
		printf '%s' "$dim"
	fi
}

row=""
add() { [ -n "$1" ] && row="${row:+$row  }$1"; }

# Work sessions authenticate via ANTHROPIC_API_KEY and live under
# ~/.claude-work; identify them from transcript_path, since the statusline
# subprocess does not reliably inherit CLAUDE_CONFIG_DIR.
case "$transcript" in
*/.claude-work/*) add "${red}⚠ WORK${reset}" ;;
esac

add "${icon_color}${i_dir}${reset} ${bold}${repo:-${dir##*/}}${reset}"

if [ -n "$dir" ]; then
	status=$(git -C "$dir" --no-optional-locks status --porcelain=v2 --branch 2>/dev/null)
	if [ -n "$status" ]; then
		branch=''
		dirty=0
		while IFS= read -r line; do
			case "$line" in
			'# branch.head '*) branch="${line#\# branch.head }" ;;
			'# '*) ;;
			*) dirty=$((dirty + 1)) ;;
			esac
		done <<<"$status"
		[ "$branch" = "(detached)" ] && branch="${dim}detached"
		add "${icon_color}${i_branch}${reset} ${gold}${branch}${reset}$([ "$dirty" -gt 0 ] && printf ' %s±%d%s' "$blue" "$dirty" "$reset")"
	fi
fi

add "${model:+${green_b}${model}${reset}}${effort:+ ${dim}${effort}${reset}}"
[ -n "$ctx" ] && add "${icon_color}${i_ctx}${reset} $(heat "$ctx")$(printf '%.0f%%' "$ctx")$reset"
[ -n "$hourly" ] && add "$(heat "$hourly")$(printf '5h %.0f%%' "$hourly")$reset"

printf '%b\n' "$row"
