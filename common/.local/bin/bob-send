#!/usr/bin/env bash
set -euo pipefail

# bob-send — send a message to Bob, my digital assistant, through Rex
#
#   bob-send <text>   sends the text
#   bob-send          opens a scratch file in nvim; save and quit sends it,
#                     an empty file sends nothing, q in normal mode cancels
#
# A failure waits for a key, so a popup running this stays open to show it.

fail() {
	echo "bob: $1" >&2
	[ -t 0 ] && read -rsn1 -p "Press any key to close."
	exit 1
}

if [ $# -gt 0 ]; then
	text="$*"
else
	file=$(mktemp "${TMPDIR:-/tmp}/bob.XXXXXX")
	trap 'rm -f "$file"' EXIT
	nvim -c 'set filetype=markdown' -c 'nnoremap <buffer> q <cmd>cquit<cr>' -c startinsert "$file" || exit 0
	text=$(cat "$file")
	[ -n "${text//[[:space:]]/}" ] || exit 0
fi

send_rex() {
	local session block _
	read -r session block _ < <(bob-pane) || fail "no Rex pane runs a session named Bob"
	# Bracketed paste keeps newlines in the text from submitting early
	rex send -s "$session" -b "$block" $'\e[200~'"$text"$'\e[201~' || fail "rex send failed"
	sleep 0.2
	rex send-key -s "$session" -b "$block" Enter || fail "rex send-key failed"
}

send_rex
echo "Sent to Bob."
