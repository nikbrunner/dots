#!/usr/bin/env bash
# ccstatusline custom-command widget: which Claude account this session runs on.
#
# The built-in claude-account-email widget reads oauthAccount.emailAddress from
# the active .claude.json and renders nothing when it is absent. The work
# instance authenticates with ANTHROPIC_API_KEY instead of an OAuth login, so
# that field is null there and the line silently collapses. This prints an
# explicit label in both cases so an unlabelled line always means "broken",
# never "work".
#
# The instance is identified from transcript_path rather than CLAUDE_CONFIG_DIR,
# because the statusline subprocess is not guaranteed to inherit that variable.

input=$(cat)
transcript=$(echo "$input" | jq -r '.transcript_path // empty')

case "$transcript" in
*/.claude-work/*)
	printf '\033[1;31m⚠ WORK — ImFusion (API key)\033[0m'
	exit 0
	;;
esac

# The default install keeps its config at ~/.claude.json, beside the config
# directory rather than inside it; a CLAUDE_CONFIG_DIR install keeps it within.
if [ -n "$CLAUDE_CONFIG_DIR" ]; then
	config_json="$CLAUDE_CONFIG_DIR/.claude.json"
else
	config_json="$HOME/.claude.json"
fi
email=$(jq -r '.oauthAccount.emailAddress // empty' "$config_json" 2>/dev/null)

if [ -z "$email" ]; then
	printf '\033[1;33m⚠ account unknown\033[0m'
	exit 0
fi

printf 'Account: %s' "$email"
