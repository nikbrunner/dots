#!/usr/bin/env bash
set -euo pipefail

# bob-pane — print "<session> <block> <window>" of the Rex pane labelled Bob,
# or exit 1 when none exists. Rex's Lua can't reach another session's blocks,
# so the bob_toggle action in rex/init.lua asks this script.

export PATH="/opt/homebrew/bin:$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS:$PATH"

for session in $(rex ls --json | jq -r '.sessions[].session_id'); do
	rex block ls -s "$session" --json |
		jq -er --arg s "$session" 'first(.blocks[] | select((.label // "") | ascii_downcase == "bob")) | "\($s) \(.block_id) \(.window_id)"' &&
		exit 0
done
exit 1
