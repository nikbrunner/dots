#!/usr/bin/env bash
set -euo pipefail

# tom-pane — print "<session> <block> <window>" of the Rex pane titled tom,
# or exit 1 when none runs. Rex's Lua can't reach another session's blocks,
# so the tom_toggle action in rex/init.lua asks this script.

export PATH="/opt/homebrew/bin:$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS:$PATH"

for session in $(rex ls --json | jq -r '.sessions[].session_id'); do
	while read -r block window; do
		if [ "$(rex block call -s "$session" -b "$block" title 2>/dev/null | jq -r '.title // empty')" = tom ]; then
			echo "$session $block $window"
			exit 0
		fi
	done < <(rex block ls -s "$session" --json | jq -r '.blocks[] | "\(.block_id) \(.window_id)"')
done
exit 1
