{
  "version": 2,
  "system_appearance": true,
  "active_theme": "black-atom-jpn-sanshoku-dark",
  "keymappings": {
    "toggle_window": "super+ctrl+alt+shift+KeyT"
  },
  "apps": {
    "nvim": {
      "enabled": true,
      "config_path": "~/.config/nvim/plugin/50_specs/black_atom/nvim.lua",
      "match_pattern": "vim\\.cmd\\.colorscheme\\(\"[^\"]*\"\\)",
      "replace_template": "vim.cmd.colorscheme(\"{themeKey}\")",
      "settings_path": "~/.config/nvim/init.lua",
      "settings": {
        "term_colors": true,
        "styles": {
          "transparency": "none",
          "ending_tildes": false,
          "cmp_kind_color_mode": "bg",
          "dark_sidebars": true,
          "dark_floats": true,
          "diagnostics": {
            "undercurl": false,
            "background": false
          },
          "syntax": {
            "comments": {
              "bold": false,
              "italic": true
            },
            "keywords": {
              "bold": true,
              "italic": false
            },
            "functions": {
              "bold": false,
              "italic": false
            },
            "strings": {
              "bold": false,
              "italic": false
            },
            "variables": {
              "bold": false,
              "italic": false
            },
            "messages": {
              "bold": true,
              "italic": false
            }
          }
        }
      }
    },
    "tmux": {
      "enabled": true,
      "config_path": "~/.config/tmux/tmux.conf",
      "themes_path": "~/.config/tmux/themes",
      "match_pattern": "^source-file\\s+.+/themes/.+\\.conf$",
      "replace_template": "source-file {themesPath}/{themeKey}.conf"
    },
    "ghostty": {
      "enabled": true,
      "config_path": "~/.config/ghostty/config",
      "match_pattern": "^theme\\s*=\\s*.+$",
      "replace_template": "theme = {themeKey}.conf"
    },
    "zed": {
      "enabled": true,
      "config_path": "~/.config/zed/settings.json"
    },
    "delta": {
      "enabled": true,
      "config_path": "~/.gitconfig.delta",
      "match_pattern": "features\\s*=\\s*black-atom-(dark|light)",
      "replace_template": "features = black-atom-{appearance}"
    },
    "lazygit": {
      "enabled": true,
      "config_path": "~/.config/lazygit/config.yml",
      "themes_path": "~/.local/share/black-atom/themes/lazygit"
    },
    "herdr": {
      "enabled": true,
      "config_path": "~/.config/herdr/config.toml",
      "themes_path": "~/.local/share/black-atom/themes/herdr"
    },
    "obsidian": {
      "enabled": true,
      "config_folders": [
        "/Users/brunner/repos/nikbrunner/notes/.obsidian",
        "/Users/brunner/repos/nikbrunner/imf-notes/.obsidian"
      ]
    },
    "helm-tmux": {
      "enabled": true,
      "config_path": "~/.config/black-atom/helm-tmux/config.yml",
      "match_pattern": "^theme:\\s*\\S*$",
      "replace_template": "theme: {themeKey}"
    }
  }
}