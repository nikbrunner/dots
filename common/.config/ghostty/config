# Generated by Spectre - Ghostty Config Generator
# https://github.com/imrajyavardhan12/spectre-ghostty-config

# Colors
theme = black-atom-jpn-koyo-dark.conf
bold-is-bright = true

# Window
window-padding-x = 25
window-padding-y = 25,10
window-vsync = true

# Shader
custom-shader = ./shaders/black-atom-grain.glsl
# custom-shader = ./shaders/blueprint.glsl
# custom-shader = ./shaders/bloom075.glsl
# custom-shader = ./shaders/tft.glsl

adjust-cell-height = 15%
adjust-underline-position = 3

# Fonts
font-size = 13
font-family = TX-02
font-style-bold = Bold
font-thicken = false

window-inherit-working-directory = true
unfocused-split-opacity = 1
window-inherit-font-size = true
window-theme = system

# background-opacity = 0.9
# background-blur = 65

background-image = ./backgrounds/scarth/scarth-charcoal-sitting.jpg
background-image-fit = cover
background-image-position = center-right
background-image-opacity = 0.1

# Cursor
adjust-cursor-thickness = 5
cursor-style-blink = false
cursor-style = block

# Shell
shell-integration-features = no-cursor

# Macos
macos-titlebar-style = hidden
macos-icon = paper
macos-option-as-alt = left

# Application
link-url = true
link-previews = true
maximize = true

# Mouse
mouse-hide-while-typing = true

# Clipboard
clipboard-trim-trailing-spaces = true

# Keybinds
keybind = global:shift+ctrl+alt+space=toggle_quick_terminal
keybind = cmd+z=toggle_fullscreen

# Zoom (font size) — Moonlander sends Super+-/= 0 on media layer
keybind = super+minus=decrease_font_size:1
keybind = super+equal=increase_font_size:1
keybind = super+zero=reset_font_size
keybind = super+h=previous_tab
keybind = super+l=next_tab

# Umlauts — macOS Option+U dead key, which left Option (as Alt) can't reach
keybind = alt+u>a=text:ä
keybind = alt+u>o=text:ö
keybind = alt+u>u=text:ü
keybind = alt+u>shift+a=text:Ä
keybind = alt+u>shift+o=text:Ö
keybind = alt+u>shift+u=text:Ü

# Quick-terminal
quick-terminal-position = center
quick-terminal-size = 65%, 65%
