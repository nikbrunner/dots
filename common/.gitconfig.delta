# Managed by livery — https://github.com/black-atom-industries/livery

[include]
    path = ~/.config/delta/themes/black-atom-minium-polymer-light.gitconfig

[delta]
    navigate = true
    side-by-side = false
    wrap-max-lines = 0
    hyperlinks = true
    hyperlinks-file-link-format = "lazygit-edit://{path}:{line}"
    line-numbers = true
